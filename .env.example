# WhatsApp AI Agent - Environment Configuration

# Server
PORT=3001

# Google Gemini API
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API (Graph API v21.0)
# From Meta for Developers > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=shipplix_agent_webhook_verify_2026

# Supabase Database (Optional - persistent JSON storage fallback active by default)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Agent Defaults
DEFAULT_MODE=ai
MAX_RAG_CHUNKS=4
RAG_SIMILARITY_THRESHOLD=0.35
